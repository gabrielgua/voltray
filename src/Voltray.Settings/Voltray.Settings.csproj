<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- required by CsWinRT AOT generated code -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\voltray.ico</ApplicationIcon>
    <!-- Own Main: single instance before WinUI starts -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Voltray.Ipc\Voltray.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\voltray.ico" Link="voltray.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\voltray-256.png" Link="voltray-256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- `dotnet publish -o` does not copy the app's own .pri (compiled XAML resources); without it
       every theme resource lookup fails at startup (0xC000027B). -->
  <Target Name="CopyAppPri" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" Condition="Exists('$(OutDir)$(TargetName).pri')" />
  </Target>

</Project>
