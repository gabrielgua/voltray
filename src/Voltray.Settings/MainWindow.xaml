<Window
    x:Class="Voltray.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (content extends into it) -->
        <Grid x:Name="AppTitleBar" Padding="12,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///voltray-256.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Voltray" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Settings / About header: back to the device list -->
        <Grid x:Name="SubHeader" Grid.Row="1" Padding="8,4,16,8" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Width="36" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="OnBackClick"
                    ToolTipService.ToolTip="Voltar" AutomationProperties.Name="Voltar">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <TextBlock x:Name="SubTitle" Grid.Column="1" FontSize="18" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <HyperlinkButton x:Name="AboutLink" Grid.Column="2" Content="Sobre" Click="OnAboutClick" VerticalAlignment="Center" />
        </Grid>

        <InfoBar
            x:Name="HostInfoBar"
            Grid.Row="2"
            Margin="8,0,8,8"
            Severity="Warning"
            IsClosable="False"
            Title="O Voltray não está em execução"
            Message="Os níveis de bateria são lidos pelo app em segundo plano.">
            <InfoBar.ActionButton>
                <Button Content="Iniciar Voltray" Click="OnStartHostClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ContentControl
            x:Name="PageHost"
            Grid.Row="3"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
