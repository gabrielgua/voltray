<UserControl
    x:Class="Voltray.Settings.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="24,4,24,24" Spacing="4">
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///voltray-256.png" Width="64" Height="64" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Voltray" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="A bateria de todos os seus periféricos sem fio, ao lado do relógio do Windows." TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Links" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <HyperlinkButton Content="Código-fonte no GitHub" NavigateUri="https://github.com/gabrielgua/voltray" />
                    <HyperlinkButton Content="Meu dispositivo não aparece" NavigateUri="https://github.com/gabrielgua/voltray/issues/new?template=device-support.yml" />
                    <HyperlinkButton Content="Relatar um problema" NavigateUri="https://github.com/gabrielgua/voltray/issues/new?template=bug_report.yml" />
                </StackPanel>
            </Border>

            <TextBlock Text="Diagnóstico" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Arquivo de log" />
                        <TextBlock Text="Anexe o voltray.log ao relatar um problema" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Abrir pasta" Click="OnOpenLogsClick" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock
                Margin="2,24,0,0"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Licença MIT. O Voltray não é afiliado à Logitech nem a outros fabricantes; nomes de produtos são marcas de seus donos." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
