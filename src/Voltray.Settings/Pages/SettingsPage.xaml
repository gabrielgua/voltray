<UserControl
    x:Class="Voltray.Settings.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="32,24,32,32" Spacing="4">
            <TextBlock Text="Configurações" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="Bandeja do sistema" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Estilo do ícone" />
                        <TextBlock Text="Como a bateria aparece na bandeja" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="IconStyleBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnIconStyleChanged"
                              AutomationProperties.Name="Estilo do ícone">
                        <ComboBoxItem Content="Barra" Tag="Glyph" />
                        <ComboBoxItem Content="Barra vertical" Tag="GlyphBarSide" />
                        <ComboBoxItem Content="Ícone colorido" Tag="GlyphColorSteps" />
                        <ComboBoxItem Content="Número" Tag="GlyphNumber" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8EF;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Mostrar o símbolo %" />
                        <TextBlock Text="No estilo Número" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="PercentSignSwitch" Grid.Column="2" MinWidth="0" OnContent="Ativado" OffContent="Desativado" Toggled="OnPercentSignToggled"
                                  AutomationProperties.Name="Mostrar o símbolo %" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Colorir o número" />
                        <TextBlock Text="No estilo Número, com a cor do nível" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ColorNumberSwitch" Grid.Column="2" MinWidth="0" OnContent="Ativado" OffContent="Desativado" Toggled="OnColorNumberToggled"
                                  AutomationProperties.Name="Colorir o número" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A9;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Ícones na bandeja" />
                        <TextBlock Text="Agrupados por categoria ou um por dispositivo" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="TrayModeBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnTrayModeChanged"
                              AutomationProperties.Name="Ícones na bandeja">
                        <ComboBoxItem Content="Um por categoria" Tag="PerCategory" />
                        <ComboBoxItem Content="Um por dispositivo" Tag="PerDevice" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE703;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Dispositivo desconectado" />
                        <TextBlock Text="Como ele aparece na bandeja" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="DisconnectedBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnDisconnectedChanged"
                              AutomationProperties.Name="Dispositivo desconectado">
                        <ComboBoxItem Content="Esmaecido" Tag="Dim" />
                        <ComboBoxItem Content="Ocultar da bandeja" Tag="Hide" />
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock Text="Notificações" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA8F;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Avisar quando a bateria estiver baixa" />
                        <TextBlock Text="Nunca enquanto o dispositivo carrega" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="NotifyLowSwitch" Grid.Column="2" MinWidth="0" OnContent="Ativado" OffContent="Desativado" Toggled="OnNotifyLowToggled"
                                  AutomationProperties.Name="Avisar quando a bateria estiver baixa" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon Glyph="&#xEBA0;" Style="{StaticResource CardIconStyle}" VerticalAlignment="Top" Margin="0,2,16,0" />
                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Spacing="10">
                        <StackPanel>
                            <TextBlock Text="Avisos de bateria baixa" />
                            <TextBlock Text="Cada um avisa uma vez ao chegar no limite" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="RuleList" Spacing="8" />
                        <Button x:Name="AddRuleButton" Content="Adicionar aviso" Click="OnAddRuleClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE83E;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Avisar quando terminar de carregar" />
                        <TextBlock Text="Se o dispositivo informar a carga" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="NotifyChargedSwitch" Grid.Column="2" MinWidth="0" OnContent="Ativado" OffContent="Desativado" Toggled="OnNotifyChargedToggled"
                                  AutomationProperties.Name="Avisar quando terminar de carregar" />
                </Grid>
            </Border>

            <TextBlock Text="Comportamento" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7E8;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Iniciar com o Windows" />
                        <TextBlock Text="Abre em segundo plano" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutostartSwitch" Grid.Column="2" MinWidth="0" OnContent="Ativado" OffContent="Desativado" Toggled="OnAutostartToggled"
                                  AutomationProperties.Name="Iniciar com o Windows" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE895;" Style="{StaticResource CardIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Intervalo de atualização" />
                        <TextBlock Text="Para dispositivos que não avisam mudanças" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="IntervalBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnIntervalChanged"
                              AutomationProperties.Name="Intervalo de atualização" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
