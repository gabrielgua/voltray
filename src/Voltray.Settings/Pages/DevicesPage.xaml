<UserControl
    x:Class="Voltray.Settings.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Voltray.Settings.ViewModels">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="32,24,32,32" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dispositivos" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="Dispositivos com bateria encontrados pelo Voltray. Escolha quais aparecem na bandeja do sistema." />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top" Click="OnRefreshClick" ToolTipService.ToolTip="Ler todos os dispositivos agora">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Atualizar" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" Margin="0,72,0,0" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
                <FontIcon Glyph="&#xE772;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Nenhum dispositivo com bateria" />
                <TextBlock
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="Conecte um mouse, teclado ou fone sem fio. Dispositivos Bluetooth precisam estar pareados nas configurações do Windows. Alguns dispositivos não informam a bateria ao computador." />
            </StackPanel>

            <ItemsControl x:Name="GroupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryGroup">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind Title}" />
                            <ItemsControl ItemsSource="{x:Bind Devices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeviceViewModel">
                                        <Border Style="{StaticResource CardStyle}">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="24" Opacity="{x:Bind CardOpacity, Mode=OneWay}" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Opacity="{x:Bind CardOpacity, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                                                </StackPanel>

                                                <!-- Battery -->
                                                <StackPanel
                                                    Grid.Column="2"
                                                    Width="132"
                                                    VerticalAlignment="Center"
                                                    Spacing="6"
                                                    AutomationProperties.Name="{x:Bind BatteryAutomationName, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                                        <FontIcon Glyph="&#xE945;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind ChargingVisibility, Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind PercentText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    </StackPanel>
                                                    <ProgressBar
                                                        Value="{x:Bind PercentValue, Mode=OneWay}"
                                                        Visibility="{x:Bind HasPercent, Mode=OneWay}"
                                                        Foreground="{x:Bind LevelBrush, Mode=OneWay}"
                                                        Maximum="100" />
                                                </StackPanel>

                                                <ToggleSwitch
                                                    Grid.Column="3"
                                                    MinWidth="0"
                                                    OnContent="Na bandeja"
                                                    OffContent="Oculto"
                                                    IsOn="{x:Bind ShownInTray, Mode=TwoWay}"
                                                    AutomationProperties.Name="Mostrar na bandeja"
                                                    VerticalAlignment="Center" />

                                                <Button
                                                    Grid.Column="4"
                                                    Padding="8"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Tag="{x:Bind}"
                                                    Click="OnMoreClick"
                                                    ToolTipService.ToolTip="Mais opções"
                                                    AutomationProperties.Name="Mais opções">
                                                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
