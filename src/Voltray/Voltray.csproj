<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\voltray.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Voltray.Core\Voltray.Core.csproj" />
    <ProjectReference Include="..\Voltray.Ipc\Voltray.Ipc.csproj" />
    <ProjectReference Include="..\Voltray.Rendering\Voltray.Rendering.csproj" />
    <ProjectReference Include="..\Voltray.Providers.Logitech\Voltray.Providers.Logitech.csproj" />
    <ProjectReference Include="..\Voltray.Providers.Bluetooth\Voltray.Providers.Bluetooth.csproj" />
    <ProjectReference Include="..\Voltray.Providers.Titorion\Voltray.Providers.Titorion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icon shown by Windows on notifications (registered with the AppUserModelID) -->
    <Content Include="..\..\assets\voltray-256.png" Link="voltray-256.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
